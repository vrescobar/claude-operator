# Ralphloop consumer config. All fields optional — defaults are documented in
# the ralphloop README. CLI flags and RALPH_* env vars override values here.

# Project spec (default: GOAL.md at repoRoot)
# goal: GOAL.md

# Iteration cap (default: 50). Each iteration drives one full phase.
# maxIterations: 50

# Commit-message prefixes (defaults: task / review)
# commit:
#   taskPrefix: task
#   reviewPrefix: review

# Agent backend (default: claude-p)
#   claude-p — claude-p wrapper, runs on the Claude subscription login (default).
#              Install pinned:  uv tool install 'claude-p==0.1.4'
#              Under claude-p, token usage is recovered from the session
#              transcript and cost is ESTIMATED from a local price table.
#   claude   — official Claude Code CLI (API-key billing)
# agentBackend: claude-p

# Claude CLI binary + model (defaults: claude / claude-opus-4-7)
# claude:
#   bin: claude
#   pBin: claude-p          # binary for the claude-p backend
#   model: claude-opus-4-7
#   timeoutS: 1800

# Reviewer→Fixer sub-loop (default: enabled, both on Opus)
# review:
#   enabled: true
#   reviewerModel: claude-opus-4-7
#   fixerModel: claude-opus-4-7
#   maxRounds: 5

# Cooldown (hours) before `ralphloop retry-blocked` will reopen a [!] task
# that was just blocked. Pass --force to bypass it. Default: 6
# blockedRetryCooldownHours: 6

# What to do when the run finishes successfully (no [ ] tasks left in any
# phase). Opt-in: by default ralphloop never touches branches and the loop
# just stays on whatever branch it ran on.
#   merge: true        — check out targetBranch and merge the work branch into
#                        it with `--no-ff` (records a merge commit), then stay
#                        there. Local only (never pushes). The work branch is
#                        kept. Skips itself when already on targetBranch, when
#                        HEAD is detached, when targetBranch is missing, or when
#                        the working tree is dirty.
#   targetBranch: main — branch to merge into (default: main).
# Env equivalents: RALPH_FINISH_MERGE=1, RALPH_FINISH_MERGE_TARGET_BRANCH=main
# finish:
#   merge: false
#   targetBranch: main
