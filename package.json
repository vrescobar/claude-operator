{
  "name": "@vrescobar/ralphloop",
  "version": "0.1.0",
  "description": "Project-agnostic autonomous coding loop. Reads a checklist, spawns Claude per task, runs tests, commits, retries — extracted from the mikoshi project.",
  "type": "module",
  "private": true,
  "bin": {
    "ralphloop": "./bin/ralphloop.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "run": "bun ./bin/ralphloop.ts run"
  },
  "dependencies": {
    "execa": "^9.0.0",
    "yaml": "^2.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
